            pcall(function() TweenService:Create(MiniScale,TweenInfo.new(0.24,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{Scale=1}):Play() end)
        else MiniBtn.Visible=false end
    end
    task.wait(0.06)
end MiniBtn.Visible=false end)


-- Velocity fling. The momentum transfer only happens if our root keeps a large
-- linear AND angular velocity while it overlaps the target, and if our parts can
-- actually collide, so noclip is suspended and CanCollide is forced on for the run.
local FLING_SECONDS=0.9
local function flingPlayer(p)
    if flinging then return end
    local myCh=LocalPlayer.Character; local myHrp=getHRP(myCh)
    local hum=myCh and myCh:FindFirstChildOfClass("Humanoid")
    local tHrp=p and p.Character and getHRP(p.Character)
    if not (myHrp and hum and tHrp) then notify("Can't fling — you or the target has no character"); return end
    flinging=true
    task.spawn(function()
        local back=myHrp.CFrame
        local restore={}
        for _,pp in ipairs(myCh:GetDescendants()) do
            if pp:IsA("BasePart") then restore[pp]=pp.CanCollide; pp.CanCollide=true end
        end
        pcall(function() hum.PlatformStand=true end)
        local t0=os.clock()
        while os.clock()-t0<FLING_SECONDS do
            local h=getHRP(LocalPlayer.Character); local t=p.Character and getHRP(p.Character)
            if not (h and t) then break end
            h.CFrame=t.CFrame
            h.AssemblyLinearVelocity=Vector3.new(0,9e4,0)
            h.AssemblyAngularVelocity=Vector3.new(9e4,9e4,9e4)
            RunService.Heartbeat:Wait()
        end
        for _=1,6 do
            local h=getHRP(LocalPlayer.Character)
            if not h then break end
            h.CFrame=back
            h.AssemblyLinearVelocity=Vector3.zero
            h.AssemblyAngularVelocity=Vector3.zero
            RunService.Heartbeat:Wait()
        end
        for pp,cc in pairs(restore) do if pp and pp.Parent then pp.CanCollide=cc end end
        pcall(function() hum.PlatformStand=false end)
        local h2=getHRP(LocalPlayer.Character)
        if h2 then h2.AssemblyLinearVelocity=Vector3.zero; h2.AssemblyAngularVelocity=Vector3.zero end
        task.wait(0.1)
        flinging=false
    end)
end


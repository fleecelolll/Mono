        local t0=os.clock()
        while os.clock()-t0<FLING_SECONDS do
            local h=getHRP(LocalPlayer.Character); local t=p.Character and getHRP(p.Character)
            if not (h and t) then break end
            h.CFrame=t.CFrame
            h.AssemblyLinearVelocity=Vector3.zero
            h.AssemblyAngularVelocity=Vector3.new(0,9e4,0)
            RunService.Heartbeat:Wait()
        end
        for _=1,14 do

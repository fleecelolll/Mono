-- Real 2D box ESP. Projects the character's world bounding box to screen space and
-- draws a rectangle around the tightest fit, so the box tracks pose and distance.
local boxStore={}
local function clearBox(plr)
    local b=boxStore[plr]
    if b then for _,l in ipairs(b) do pcall(function() l:Remove() end) end; boxStore[plr]=nil end
end
local function ensureBox(plr)
    local b=boxStore[plr]
    if b then return b end
-- Created by and originally uploaded by https://robloxscripts.com/user/Fleece
    b={}
    for i=1,4 do
        local l=Drawing.new("Line"); l.Thickness=1; l.Transparency=1; l.Visible=false; b[i]=l
    end
    boxStore[plr]=b; return b
end
local function charScreenRect(ch)
    local ok,cf,size=pcall(function() return ch:GetBoundingBox() end)
    if not ok or not cf or not size then return nil end
    local hx,hy,hz=size.X/2,size.Y/2,size.Z/2
    local minX,minY,maxX,maxY
    local anyFront=false
    for i=0,7 do
        local ox=(i%2==0) and -hx or hx
        local oy=(math.floor(i/2)%2==0) and -hy or hy
        local oz=(math.floor(i/4)%2==0) and -hz or hz
        local w=(cf*CFrame.new(ox,oy,oz)).Position
        local v=Camera:WorldToViewportPoint(w)
        if v.Z>0 then
            anyFront=true
            minX=minX and math.min(minX,v.X) or v.X
            maxX=maxX and math.max(maxX,v.X) or v.X
            minY=minY and math.min(minY,v.Y) or v.Y
            maxY=maxY and math.max(maxY,v.Y) or v.Y
        end
    end
    if not anyFront then return nil end
    return minX,minY,maxX,maxY
end

local silentAimPos
-- Closest enemy to the crosshair, ignoring line of sight entirely. Deliberately does
-- not use the game's raycast: WeaponService.GetMouseTargetCFrame stops at the first
-- opaque hit, so aiming at someone behind a wall returns the wall, which is why a
-- through-walls shot has to substitute the real target rather than only the muzzle.
local function crosshairEnemyPos(radius)
    local mr=myRole()
    if not (mr=="Murderer" or isGunRole(mr)) then return nil end
    local center=mousePos()
    local best,bd
    for _,p in ipairs(Players:GetPlayers()) do
        if p~=LocalPlayer and alive(p) and isEnemyOf(mr,roleOf(p)) then
-- Created by and originally uploaded by https://robloxscripts.com/user/Fleece
            local ch=p.Character; local hrp=getHRP(ch)
            if hrp then
                local sp=Camera:WorldToViewportPoint(hrp.Position)
                if sp.Z>0 then
                    local d=(Vector2.new(sp.X,sp.Y)-center).Magnitude
                    if d<=radius and (not bd or d<bd) then
                        bd=d
                        best=(ch:FindFirstChild("UpperTorso") or ch:FindFirstChild("Torso") or hrp).Position
                    end
                end
            end
        end
    end
    return best
end
-- Silent aim is gun-only, so it only resolves a target while we hold a gun
-- (Sheriff, or a Hero who grabbed the dropped one).
local function computeSilentTarget()
    if not isGunRole(myRole()) then return nil end
    return crosshairEnemyPos(aimFov)
end
-- Everything the namecall hook needs is precomputed here. The hook itself must not
-- make instance namecalls between getnamecallmethod() and the re-dispatch.
bind(RunService.Heartbeat,function()
    silentAimPos = flags.silentAim and computeSilentTarget() or nil
end)
pcall(function()
    local oldNamecall
    oldNamecall=hookmetamethod(game,"__namecall",newcclosure(function(self,...)
        if not checkcaller() and getnamecallmethod()=="FireServer" then
            local nm=self.Name
            if nm=="Shoot" and flags.silentAim and silentAimPos then
                local n=select("#",...)
                if n>=2 then
                    local a={...}
                    if typeof(a[2])=="CFrame" then
                        -- arg2 is the aim point and always carries identity rotation,
                        -- so swapping it alone is exactly what the game itself sends.
                        a[2]=CFrame.new(silentAimPos)
                        return oldNamecall(self,table.unpack(a,1,n))
                    end
                end
            end
        end
        return oldNamecall(self,...)
    end))
end)


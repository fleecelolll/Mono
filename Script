        end
        for pp,cc in pairs(restore) do if pp and pp.Parent then pp.CanCollide=cc end end
        pcall(function() hum.PlatformStand=false end)
        local h2=getHRP(LocalPlayer.Character)
        if h2 then h2.AssemblyLinearVelocity=Vector3.zero; h2.AssemblyAngularVelocity=Vector3.zero end
        for _=1,10 do
            RunService.Heartbeat:Wait()
